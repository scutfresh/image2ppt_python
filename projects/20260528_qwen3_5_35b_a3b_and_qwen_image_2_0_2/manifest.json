    },
    {
      "type": "text",
      "name": "Body Text 1",
      "text": "\u5927\u74e6\u7279 1.0\n2025.05\n\u5b9a\u4f4d\uff1a\u591a\u6a21\u6001\u670d\u52a1\u5316\n\u4eae\u70b9\uff1a\u5efa\u6210\u5357\u7f51\u9996\u4e2a\uff0c\u7535\u529b\u591a\u6a21\u6001\u80fd\u529b\u5165\u53e3\uff0c\u6210\u529f\u9002\u914d\u56fd\u4ea7\u7b97\u529b\uff0c\u5b9e\u73b0\u5168\u81ea\u4e3b\u5b89\u5168\u53ef\u63a7\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 16,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 50,
        "y": 250,
        "w": 200,
        "h": 450
      }
    },
    {
      "type": "text",
      "name": "Body Text 2",
      "text": "\u5927\u74e6\u7279 1.1\n2025.12\n\u5b9a\u4f4d\uff1a\u80fd\u529b\u89c4\u6a21\u5316\n\u4eae\u70b9\uff1a\u5e95\u5ea7\u5168\u9762\u8fed\u4ee3\u5347\u7ea7\uff0c\u6b63\u5f0f\u5907\u5343\u4ebf\u7ea7\u53c2\u6570\u89c4\u6a21\u6a21\u578b\u80fd\u529b\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 16,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 270,
        "y": 250,
        "w": 200,
        "h": 450
      }
    },
    {
      "type": "text",
      "name": "Body Text 3",
      "text": "\u5927\u74e6\u7279 2.0\n2026.04\n\u5b9a\u4f4d\uff1a\u884c\u4e1a\u4e13\u4e1a\u5316\n\u4eae\u70b9\uff1a\u5b8c\u621072B\u884c\u4e1a\u5fae\u8c03\u6a21\u578b\u5168\u9762\u5347\u7ea7\uff0c\u5f3a\u5316\u7535\u529b\u4e13\u4e1a\u80fd\u529b\uff0c\u9ad8\u6548\u6d41\u8f6c\u5178\u578b\u4e1a\u52a1\u573a\u666f\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 16,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 490,
        "y": 250,
        "w": 200,
        "h": 450
      }
    },
    {
      "type": "text",
      "name": "Body Text 4",
      "text": "\u5927\u74e6\u7279 2.1\n2026.06\n\u5b9a\u4f4d\uff1a\u67b6\u6784\u534f\u540c\u5316\n\u4eae\u70b9\uff1a\u4e0a\u7ebf MoE \u67b6\u6784\u5fae\u8c03\u6a21\u578b\uff0c\u5b9e\u73b0\u4e13\u5bb6\u534f\u540c\u3001\u4efb\u52a1\u5206\u6d41\u548c\u591a\u4e1a\u52a1\u57df\u534f\u540c\uff0c\u6309\u9700\u8c03\u7528\u4e13\u4e1a\u80fd\u529b\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 16,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
