    {
      "type": "text",
      "name": "title_1",
      "text": "\"\u5927\u6a21\u578b\"\u6f14\u8fdb\u8def\u7ebf\u56fe",
      "font_family": "Microsoft YaHei",
      "font_size_px": 56,
      "color": "#FFFFFF",
      "bold": true,
      "italic": false,
      "align": "center",
      "bbox": {
        "x": 425,
        "y": 16,
        "w": 1055,
        "h": 59
      }
    },
    {
      "type": "text",
      "name": "title_2",
      "text": "\u8def\u5f84\u6807\u4e0e\u6838\u5fc3\u8981\u70b9",
      "font_family": "Microsoft YaHei",
      "font_size_px": 28,
      "color": "#FFD700",
      "bold": true,
      "italic": false,
      "align": "center",
      "bbox": {
        "x": 630,
        "y": 85,
        "w": 850,
        "h": 20
      }
    },
    {
      "type": "text",
      "name": "title_3",
      "text": "\u4ece\u591a\u6a21\u6001\u670d\u52a1\u5316\u63a8\u8fdb\u5411\u7535\u529b\u4e16\u754c\u6a21\u578b",
      "font_family": "Microsoft YaHei",
      "font_size_px": 20,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "center",
      "bbox": {
        "x": 605,
        "y": 115,
        "w": 875,
        "h": 20
      }
    },
    {
      "type": "text",
      "name": "body_text_1",
      "text": "\u5927\u6a21\u578b 1.0\n\u5b9a\u4f4d\uff1a\u591a\u6a21\u6001\u670d\u52a1\u5316\n\u5efa\u6210\u5357\u7f51\u9996\u4e2a\uff0c\n\u7535\u529b\u591a\u6a21\u6001\u80fd\u529b\u5165\u53e3\uff0c\n\u6210\u529f\u9002\u914d\u56fd\u4ea7\u7b97\u529b\uff0c\n\u5b9e\u73b0\u5168\u81ea\u4e3b\u5b89\u5168\u53ef\u63a7\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 25,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
      "type": "text",
      "name": "body_text_2",
      "text": "\u5927\u6a21\u578b 1.1\n\u5b9a\u4f4d\uff1a\u80fd\u529b\u89c4\u6a21\u5316\n\u5e95\u5ea7\u5168\u9762\u8fed\u4ee3\u5347\u7ea7\uff0c\n\u6b63\u5f0f\u53d1\u5e03\u5343\u4ebf\u53c2\u6570\n\u89c4\u6a21\u6a21\u578b\u80fd\u529b\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 235,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
      "type": "text",
      "name": "body_text_3",
      "text": "\u5927\u6a21\u578b 2.0\n\u5b9a\u4f4d\uff1a\u884c\u4e1a\u4e13\u4e1a\u5316\n\u5b8c\u621072B\u884c\u4e1a\u5fae\u8c03\u6a21\u578b\n\u5168\u9762\u5347\u7ea7\uff0c\u5f3a\u5316\u7535\u529b\u4e13\n\u4e1a\u80fd\u529b\uff0c\u9ad8\u6548\u6d41\u8f6c\u5178\u578b\n\u4e1a\u52a1\u573a\u666f\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 445,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
      "type": "text",
      "name": "body_text_4",
      "text": "\u5927\u6a21\u578b 2.1\n\u5b9a\u4f4d\uff1a\u67b6\u6784\u534f\u540c\u5316\n\u4e0a\u7ebf MoE \u67b6\u6784\u5fae\u8c03\u6a21\u578b\uff0c\n\u5b9e\u73b0\u4e13\u5bb6\u534f\u540c\u3001\u4efb\u52a1\u5206\u6d41\n\u548c\u591a\u4e1a\u52a1\u57df\u534f\u540c\uff0c\u6309\u9700\u8c03\u7528\n\u4e13\u4e1a\u80fd\u529b\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 655,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
      "type": "text",
      "name": "body_text_5",
      "text": "\u5927\u6a21\u578b 2.2\n\u5b9a\u4f4d\uff1a\u63a8\u7406\u539f\u751f\u5316\n\u5f15\u5165\u5f3a\u5316\u5b66\u4e60\u4e0e\u6162\u601d\u8003\n\u673a\u5236\uff0c\u589e\u5f3a\u903b\u8f91\u63a8\u7406\u3001\n\u77e5\u8bc6\u589e\u5f3a\u548c\u5de5\u5177\u8c03\u7528\n\u80fd\u529b\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 865,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
      "type": "text",
      "name": "body_text_6",
      "text": "\u5927\u6a21\u578b 3.0\n\u5b9a\u4f4d\uff1a\u5de5\u4e1a\u56fe\u7eb8\u5316\n\u884c\u4e1a\u9996\u53d1\u7535\u529b\u591a\u6a21\u6001\n\u5de5\u4e1a\u56fe\u7eb8\u6a21\u578b\uff0c\u5177\u5907\n\u56fe\u7eb8\u89e3\u6790\u3001\u89c4\u5219\u6821\u6838\n\u548c\u8f85\u52a9\u8bbe\u8ba1\u80fd\u529b\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 1075,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
      "type": "text",
      "name": "body_text_7",
      "text": "\u5927\u6a21\u578b 3.1\n\u5b9a\u4f4d\uff1a\u62d3\u5c55\u8ba4\u77e5\u5316\n\u878d\u5408\u591a\u6e90\u6570\u636e\uff0c\u6784\u5efa\u201c\u56fe\u50cf\n\u4e00\u8bbe\u5907\u4e00\u7a7a\u95f4\u4e00\u62d3\u5c55\u201d\u8054\u5408\n\u63a8\u7406\u80fd\u529b\uff0c\u5f62\u6210\u7535\u529b\u884c\u4e1a\n\u7ed3\u6784\u5316\u8ba4\u77e5\u57fa\u5ea7\u3002",
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "bbox": {
        "x": 1285,
        "y": 140,
        "w": 180,
        "h": 290
      }
    },
    {
