    },
    {
      "type": "text",
      "name": "Timeline Text 2",
      "text": "\u5927\u74e6\u7279 1.1\n2025.12\n\u5b9a\u4f4d\uff1a\u80fd\u529b\u89c4\u6a21\u5316\n\u4eae\u70b9\uff1a\n\u5e95\u5ea7\u5168\u9762\u8fed\u4ee3\u5347\u7ea7\uff0c\u6b63\u5f0f\u5907\u5343\u4ebf\u7ea7\u53c2\u6570\u89c4\u6a21\u6a21\u578b\u80fd\u529b\u3002",
