      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "z_index": 100
    },
    {
      "type": "text",
      "name": "body_text",
      "text": "\u5927\u74e6\u7279 2.1\n2026.06\n\u5b9a\u4f4d\uff1a\u67b6\u6784\u534f\u540c\u5316\n\u4eae\u70b9\uff1a\u4e0a\u7ebf MoE \u67b6\u6784\u5fae\u8c03\u6a21\u578b\uff0c\u5b9e\u73b0\u4e13\u5bb6\u534f\u540c\u3001\u4efb\u52a1\u5206\u6d41\u548c\u591a\u4e1a\u52a1\u57df\u534f\u540c\uff0c\u6309\u9700\u8c03\u7528\u4e13\u4e1a\u80fd\u529b\u3002",
      "bbox": [
        460,
        200,
        580,
