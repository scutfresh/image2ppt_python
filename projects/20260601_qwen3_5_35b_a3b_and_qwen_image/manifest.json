    {
      "type": "text",
      "name": "body_text",
      "text": "\u5927\u74e6\u7279 1.0\n2025.05\n\u5b9a\u4f4d\uff1a\u591a\u6a21\u6001\u670d\u52a1\u5316\n\u4eae\u70b9\uff1a\u5efa\u6210\u5357\u7f51\u9996\u4e2a\uff0c\u7535\u529b\u591a\u6a21\u6001\u80fd\u529b\u5165\u53e3\uff0c\u6210\u529f\u9002\u914d\u56fd\u4ea7\u7b97\u529b\uff0c\u5b9e\u73b0\u5168\u81ea\u4e3b\u5b89\u5168\u53ef\u63a7\u3002",
      "bbox": [
        40,
        200,
        160,
        480
      ],
      "font_family": "Microsoft YaHei",
      "font_size_px": 18,
      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left",
      "z_index": 100
    },
    {
      "type": "text",
      "name": "body_text",
      "text": "\u5927\u74e6\u7279 1.1\n2025.12\n\u5b9a\u4f4d\uff1a\u80fd\u529b\u89c4\u6a21\u5316\n\u4eae\u70b9\uff1a\u5e95\u5ea7\u5168\u9762\u8fed\u4ee3\u5347\u7ea7\uff0c\u6b63\u5f0f\u5907\u5343\u4ebf\u7ea7\u53c2\u89c4\u6a21\u578b\u80fd\u529b\u3002",
      "bbox": [
        180,
        200,
        300,
        480
      ],
