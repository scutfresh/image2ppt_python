    },
    {
      "type": "text",
      "name": "body_text",
      "text": "\u5927\u74e6\u7279 2.2\n2026.08\n\u5b9a\u4f4d\uff1a\u63a8\u7406\u539f\u751f\u5316\n\u4eae\u70b9\uff1a\u5f15\u5165\u5f3a\u5316\u5b66\u4e60\u4e0e\u6162\u601d\u8003\u673a\u5236\uff0c\u589e\u5f3a\u903b\u8f91\u63a8\u7406\u3001\u77e5\u8bc6\u589e\u5f3a\u548c\u5de5\u5177\u8c03\u7528\u80fd\u529b\u3002",
      "bbox": [
        600,
