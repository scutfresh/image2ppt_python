    },
    {
      "type": "text",
      "name": "body_text",
      "text": "\u5927\u74e6\u7279 3.1\n2027.04\n\u5b9a\u4f4d\uff1a\u62d3\u6251\u8ba4\u77e5\u5316\n\u4eae\u70b9\uff1a\u878d\u5408\u591a\u6e90\u6570\u636e\uff0c\u6784\u5efa\u201c\u56fe\u50cf\u2014\u8bbe\u5907\u2014\u7a7a\u95f4\u2014\u62d3\u6251\u201d\u8054\u5408\u63a8\u7406\u80fd\u529b\uff0c\u5f62\u6210\u7535\u529b\u884c\u4e1a\u7ed3\u6784\u5316\u8ba4\u77e5\u58c1\u5792\u3002",
      "bbox": [
        880,
