      "bold": false,
      "italic": false,
      "align": "left"
    },
    {
      "text": "\u5927\u74e6\u7279 4.0\n2027.12\n\u5b9a\u4f4d\uff1a\u4e16\u754c\u6a21\u578b\u5316\n\u4eae\u70b9\uff1a\u53d1\u5e03\u7535\u529b\u591a\u6a21\u6001\u4e16\u754c\u6a21\u578b\uff0c\u5b9e\u73b0\u7269\u7406\u4eff\u771f\u4e0e\u667a\u80fd\u63a8\u6f14\u3001\u4ece\u7406\u89e3\u73b0\u573a\u8fc8\u5411\u63a8\u6f14\u73b0\u573a\u3001\u8f85\u52a9\u51b3\u7b56\u3002",
