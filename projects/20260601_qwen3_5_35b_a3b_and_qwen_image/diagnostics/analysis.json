      "color": "#FFFFFF",
      "bold": false,
      "italic": false,
      "align": "left"
    },
    {
      "text": "\u7edf\u4e00\u670d\u52a1\n\u7535\u529b\u4e13\u4e1a\u591a\u6a21\u6001\u80fd\u529b\u5f15\u64ce\n\u7edf\u4e00\u4e1a\u52a1\u5e95\u5ea7\n\u4e1a\u52a1\u9a71\u52a8 \u00b7 \u573a\u666f\u666e\u60e0\n\u7edf\u4e00\u6570\u636e\u5e95\u5ea7\n\u6570\u636e\u878d\u5408 \u00b7 \u77e5\u8bc6\u589e\u5f3a\n\u7edf\u4e00\u6280\u672f\u5e95\u5ea7\n\u7b97\u6cd5\u9886\u5148 \u00b7 \u5de5\u7a0b\u53ef\u9760\n\u5168\u57df\u6570\u636e\u878d\u5408\u4e0e\u77e5\u8bc6\u6c89\u6dc0\n\u7535\u7f51\u751f\u4ea7\u57df\n\u8bbe\u5907\u8d44\u4ea7\u57df\n\u8425\u9500\u670d\u52a1\u57df\n\u5b89\u5168\u7ba1\u7406\u57df\n\u5916\u90e8\u73af\u5883\u57df",
